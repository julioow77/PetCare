<?xml version="1.0" encoding="UTF-8"?>
<project name="PetCare" default="jar" basedir=".">
    <property file="nbproject/private/config.properties"/>
    <property name="config" value="default"/>
    <property file="nbproject/private/configs/${config}.properties"/>
    <property file="nbproject/private/private.properties"/>
    <property file="nbproject/configs/${config}.properties"/>
    <property file="nbproject/project.properties"/>
    <property name="application.args" value=""/>
    <property name="run.jvmargs" value=""/>
    <import file="nbproject/build-impl.xml" optional="true"/>

    <target name="compile">
        <mkdir dir="${build.classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}" release="17"
               encoding="${source.encoding}" debug="true" includeantruntime="false"/>
        <copy todir="${build.classes.dir}">
            <fileset dir="${src.dir}" includes="**/*.png"/>
        </copy>
    </target>

    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest><attribute name="Main-Class" value="${main.class}"/></manifest>
        </jar>
    </target>

    <target name="run" depends="compile">
        <java classname="${main.class}" classpath="${build.classes.dir}" dir="${basedir}"
              fork="true" failonerror="true">
            <jvmarg line="${run.jvmargs}"/>
            <arg line="${application.args}"/>
        </java>
    </target>

    <target name="compile-single" depends="compile"/>
    <target name="run-single" depends="compile">
        <property name="run.class" value="${main.class}"/>
        <java classname="${run.class}" classpath="${build.classes.dir}" dir="${basedir}"
              fork="true" failonerror="true">
            <jvmarg line="${run.jvmargs}"/>
            <arg line="${application.args}"/>
        </java>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
    <target name="rebuild" depends="clean,jar"/>
</project>
